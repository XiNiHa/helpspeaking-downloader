{
	"name": "helpspeaking-downloader",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"typegen": "wrangler types src/worker/worker-configuration.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --remote",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@cloudflare/puppeteer": "^1.4.0",
		"@effect/platform-browser": "4.0.5",
		"@effect/sql-d1": "4.0.5",
		"drizzle-orm": "1.0.0-rc.5-5935859",
		"effect": "4.0.5",
		"foldkit": "0.168.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.64.0",
		"@effect/language-service": "^0.87.4",
		"@foldkit/vite-plugin": "0.27.1",
		"@tailwindcss/vite": "4.3.3",
		"drizzle-kit": "1.0.0-rc.5-5935859",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"tailwindcss": "4.3.3",
		"typescript": "~5.9.3",
		"vite": "8.3.4",
		"vite-plugin-pwa": "2.0.0",
		"workbox-window": "7.4.1",
		"wrangler": "^4.151.1"
	},
	"packageManager": "pnpm@10.30.2",
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"foldkit>effect": "4.0.5",
				"foldkit>@effect/platform-browser": "4.0.5",
				"@foldkit/vite-plugin>effect": "4.0.5"
			}
		}
	}
}
